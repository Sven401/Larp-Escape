(version 1)
(rule "JLC inner PTH drill to foreign copper 3.00mm"
 (layer inner)
 (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
 (constraint hole_clearance (min 3.00mm)))
(rule "JLC inner via drill to foreign copper 0.20mm"
 (layer inner)
 (condition "A.Type == 'Via'")
 (constraint hole_clearance (min 0.20mm)))
