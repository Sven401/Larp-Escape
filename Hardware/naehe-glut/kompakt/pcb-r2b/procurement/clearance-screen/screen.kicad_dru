(version 1)
(rule "JLC PTH drill to foreign copper all layers 0.28mm"
 (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
 (constraint hole_clearance (min 0.28mm)))
(rule "JLC inner PTH drill to foreign copper 0.30mm"
 (layer inner)
 (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
 (constraint hole_clearance (min 0.30mm)))
(rule "JLC via drill to foreign copper all layers 0.20mm"
 (condition "A.Type == 'Via'")
 (constraint hole_clearance (min 0.20mm)))
