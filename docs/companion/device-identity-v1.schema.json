{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public device display identity v1; no authentication proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "deviceId",
    "scope",
    "requiresVerifiedConnection",
    "requiresGameMasterAssignment"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "device_identity"
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[0-9A-F]{32}$",
      "not": {
        "const": "00000000000000000000000000000000"
      },
      "minLength": 32,
      "maxLength": 32
    },
    "scope": {
      "const": "display_identity"
    },
    "requiresVerifiedConnection": {
      "const": true
    },
    "requiresGameMasterAssignment": {
      "const": true
    }
  }
}
